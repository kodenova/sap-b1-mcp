    "sap-b1",
    "service-layer",
    "erp",
    "ai",
    "claude",
    "chatgpt"
  ],
  "author": "Kodenova (Zain Abbas) <https://kodenova.com>",
  "license": "MIT",
  "homepage": "https://kodenova.com/services/mcp-server-development/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodenova/sap-b1-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kodenova/sap-b1-mcp/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }

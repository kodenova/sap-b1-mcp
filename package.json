{
  "name": "@kodenova/sap-b1-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for SAP Business One Service Layer: business partners, items, orders, invoices, stock.",
  "mcpName": "io.github.kodenova/sap-b1-mcp",
  "type": "module",
  "bin": {
    "sap-b1-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [

# Copy to your MCP client config (env block). Never commit real values.
SAPB1_SERVICE_LAYER_URL=https://your-b1-server:50000/b1s/v1
SAPB1_COMPANY_DB=SBODEMOUS
SAPB1_USERNAME=mcp_readonly
SAPB1_PASSWORD=change-me
# Optional
SAPB1_ALLOW_SELF_SIGNED=0
SAPB1_MAX_ROWS=50
SAPB1_TIMEOUT_MS=30000
SAPB1_SAVED_QUERIES_FILE=./config/saved-queries.json
SAPB1_LOG_LEVEL=info
# Set to 1 to run against bundled fixture data, no SAP needed
SAPB1_MOCK=0
